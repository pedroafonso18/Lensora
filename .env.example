# Anthropic API key (required)
API_KEY=your_api_key_here

# Clerk JWKS endpoint for verifying session tokens (required)
# Find it at: Clerk Dashboard → API Keys → Advanced → JWKS Endpoint
# Format: https://<frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-frontend-api.clerk.accounts.dev/.well-known/jwks.json

# Port the server listens on (optional, default: 3000)
PORT=3000

# Log level (optional, default: info for this crate)
# Examples: debug, info, warn, error, lensora=debug
RUST_LOG=lensora=info
